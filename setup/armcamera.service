[Unit]
Description=ARM disc camera and barcode scanner service
## Photographs discs in the open drive tray and records case barcodes so the ripper can attach them to the job
After=network-online.target
Wants=network-online.target
Before=shutdown.target

[Service]
Type=simple
User=arm
Group=arm
## The daemon writes and rotates /home/arm/logs/camera.log itself; stdout goes to the journal
## so every line is not written to that file twice.
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=3
ExecStart=/opt/arm/venv/bin/python3 /opt/arm/arm/camera/daemon.py

## Graceful shutdown behaviour
KillSignal=SIGTERM
TimeoutStopSec=30
KillMode=mixed
SendSIGKILL=no

[Install]
WantedBy=multi-user.target
